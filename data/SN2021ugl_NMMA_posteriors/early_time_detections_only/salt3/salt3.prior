luminosity_distance = Uniform(minimum=0.001, maximum=7000, name='luminosity_distance', latex_label='$D_L$', unit=None, boundary=None)
timeshift = Uniform(minimum=-30.0, maximum=30.0, name='trigger_time', latex_label='$t_0$', unit=None, boundary=None)
x0 = Uniform(minimum=0.0, maximum=10.0, name='x0', latex_label='$x_0$', unit=None, boundary=None)
x1 = Uniform(minimum=-5.0, maximum=5.0, name='x1', latex_label='$x_1$', unit=None, boundary=None)
c = Uniform(minimum=-0.5, maximum=2.0, name='c', latex_label='$c$', unit=None, boundary=None)
